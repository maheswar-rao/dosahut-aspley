rules_version = '2';

// Every read/write to this project's Firestore data goes through the
// Firebase Admin SDK from our own server (see lib/firebase-admin.ts), which
// bypasses these rules entirely — there is no client-side Firebase SDK in
// this app. This file exists purely as a version-controlled, explicit
// default-deny backstop: without it, a new Firestore database can be left
// on Firebase's temporary wide-open "test mode" rules, or a future change
// could add client-side Firestore access without anyone noticing there was
// never a deny-by-default policy in place.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
